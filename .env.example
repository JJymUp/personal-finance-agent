# Safe default: synthetic/local mock mode. Set false explicitly for real model calls.
FORCE_MOCK=true

# Server-only credentials; never use a VITE_ prefix or commit actual values.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Optional server settings (model requests consume your provider's quota).
OPENAI_API_TIMEOUT=30000
OPENAI_API_MAX_RETRIES=2
PORT=3000
