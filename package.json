{
  "name": "maggot-finance-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @maggot/server dev",
    "dev:web": "pnpm --filter @maggot/web dev",
    "cli": "pnpm build && node scripts/cli-agent.mjs",
    "eval": "pnpm build && node scripts/batch-cloud-eval.mjs",
    "eval:mock": "pnpm build && node scripts/batch-cloud-eval.mjs --provider mock",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.12.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "vue-eslint-parser": "^10.4.2"
  }
}
